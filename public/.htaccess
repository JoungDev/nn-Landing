# Evita que se pueda ver la lista de archivos de una carpeta
Options -Indexes

<IfModule mod_headers.c>
  # Evita que el navegador intente interpretar archivos con otro tipo
  Header always set X-Content-Type-Options "nosniff"

  # Controla qué información de la URL se comparte con sitios externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Impide mostrar la landing dentro de iframes de otros sitios
  Header always set X-Frame-Options "DENY"

  # Bloquea permisos que la landing no necesita
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Solo permite recursos del mismo dominio
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>